      "html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>Streich Bros. Employee Bundle Program</title>\n    <link href=\"https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css\" rel=\"stylesheet\">\n    <link rel=\"stylesheet\" href=\"https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css\">\n    <!-- Streich Bros Brand Typography -->\n    <link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n    <link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\n    <link href=\"https://fonts.googleapis.com/css2?family=Roboto:wght@300;400;500;600;700;900&family=Roboto+Slab:wght@400;600;700&display=swap\" rel=\"stylesheet\">\n    <link rel=\"stylesheet\" href=\"/shared_components/css/tokens.css?v=2026.09.08.2\">\n    <link rel=\"stylesheet\" href=\"/employee-bundles/css/streich-bros-bundle.css?v=2026.09.07.18\">\n</head>\n<body>\n    <div class=\"header\">\n        <div class=\"container text-center\">\n            <div class=\"logo-container\">\n                <img src=\"https://c3eku948.caspio.com/dp/a0e150004df4984fb1ef4d30b01a/files/9172150\" alt=\"Streich Bros. Logo\">\n            </div>\n            <h1>Employee Bundle Program</h1>\n            <p>Manage team apparel sizes and orders</p>\n        </div>\n    </div>\n\n    <main class=\"container\">\n        <div class=\"content-section\">\n            <h2 class=\"section-title\">\n                <i class=\"fas fa-tag\" aria-hidden=\"true\"></i> Avery 5960 (2.5\" x 1\") Box Labels\n            </h2>\n\n            <div class=\"important-note\">\n                <div><i class=\"fas fa-exclamation-circle\" aria-hidden=\"true\"></i><strong>Important:</strong></div>\n                <div>Account Executives must mark each employee name as 'Approved' in the table below to ensure the customer's spreadsheet matches this data.</div>\n            </div>\n\n            <div class=\"instructions-box\">\n                <h5 class=\"mb-3\"><i class=\"fas fa-print\" aria-hidden=\"true\"></i> How to Print Labels</h5>\n\n                <div class=\"instruction-step\">\n                    <div class=\"step-number\">1</div>\n                    <div class=\"step-content\">Download all the names and sizes into Excel</div>\n                </div>\n\n                <div class=\"instruction-step\">\n                    <div class=\"step-number\">2</div>\n                    <div class=\"step-content\">Import them into Microsoft Word using the mail merge</div>\n                </div>\n\n                <div class=\"instruction-step\">\n                    <div class=\"step-number\">3</div>\n                    <div class=\"step-content\">Print them on the Avery 5960 labels</div>\n                </div>\n            </div>\n\n            <div class=\"caspio-container\">\n                <script type=\"text/javascript\" src=\"https://c3eku948.caspio.com/dp/a0e15000905016abc7b946ad8b6f/emb\"></script>\n            </div>\n        </div>\n\n        <div class=\"company-bundles\">\n            <h3 class=\"bundles-title\">\n                <i class=\"fas fa-building\" aria-hidden=\"true\"></i>\n                EMPLOYEE BUNDLES\n            </h3>\n\n            <div class=\"bundles-grid\">\n                <a href=\"/DrainPro-Bundle.html\" class=\"bundle-card text-decoration-none\">\n                    <i class=\"fas fa-users\" aria-hidden=\"true\"></i>\n                    <div class=\"bundle-name\">Drain-Pro</div>\n                </a>\n\n                <div class=\"bundle-card active\">\n                    <i class=\"fas fa-hard-hat\" aria-hidden=\"true\"></i>\n                    <div class=\"bundle-name\">Streich Bros.</div>\n                </div>\n\n                <a href=\"/wcttr-bundle.html\" class=\"bundle-card text-decoration-none\">\n                    <i class=\"fas fa-truck\" aria-hidden=\"true\"></i>\n                    <div class=\"bundle-name\">WCTTR</div>\n                </a>\n\n                <div class=\"bundle-card\">\n                    <i class=\"fas fa-building\" aria-hidden=\"true\"></i>\n                    <div class=\"bundle-name\">Company 4</div>\n                    <div class=\"bundle-status\">Coming Soon</div>\n                </div>\n\n                <div class=\"bundle-card\">\n                    <i class=\"fas fa-building\" aria-hidden=\"true\"></i>\n                    <div class=\"bundle-name\">Company 5</div>\n                    <div class=\"bundle-status\">Coming Soon</div>\n                </div>\n\n                <div class=\"bundle-card\">\n                    <i class=\"fas fa-building\" aria-hidden=\"true\"></i>\n                    <div class=\"bundle-name\">Company 6</div>\n                    <div class=\"bundle-status\">Coming Soon</div>\n                </div>\n\n                <div class=\"bundle-card\">\n                    <i class=\"fas fa-building\" aria-hidden=\"true\"></i>\n                    <div class=\"bundle-name\">Company 7</div>\n                    <div class=\"bundle-status\">Coming Soon</div>\n                </div>\n\n                <div class=\"bundle-card\">\n                    <i class=\"fas fa-building\" aria-hidden=\"true\"></i>\n                    <div class=\"bundle-name\">Company 8</div>\n                    <div class=\"bundle-status\">Coming Soon</div>\n                </div>\n            </div>\n        </div>\n\n        <div class=\"footer-logo\">\n            <img src=\"https://c3eku948.caspio.com/dp/a0e150004df4984fb1ef4d30b01a/files/9172150\" alt=\"Streich Bros. Logo\">\n        </div>\n    </main>\n\n    <script src=\"https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.bundle.min.js\"></script>\n</body>\n</html>\n",
