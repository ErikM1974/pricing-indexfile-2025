dle-name\">WCTTR</div>\n                </div>\n\n                <div class=\"bundle-card\">\n                    <i class=\"fas fa-building\" aria-hidden=\"true\"></i>\n                    <div class=\"bundle-name\">Company 4</div>\n                    <div class=\"bundle-status\">Coming Soon</div>\n                </div>\n\n                <div class=\"bundle-card\">\n                    <i class=\"fas fa-building\" aria-hidden=\"true\"></i>\n                    <div class=\"bundle-name\">Company 5</div>\n                    <div class=\"bundle-status\">Coming Soon</div>\n                </div>\n\n                <div class=\"bundle-card\">\n                    <i class=\"fas fa-building\" aria-hidden=\"true\"></i>\n                    <div class=\"bundle-name\">Company 6</div>\n                    <div class=\"bundle-status\">Coming Soon</div>\n                </div>\n\n                <div class=\"bundle-card\">\n                    <i class=\"fas fa-building\" aria-hidden=\"true\"></i>\n                    <div class=\"bundle-name\">Company 7</div>\n                    <div class=\"bundle-status\">Coming Soon</div>\n                </div>\n\n                <div class=\"bundle-card\">\n                    <i class=\"fas fa-building\" aria-hidden=\"true\"></i>\n                    <div class=\"bundle-name\">Company 8</div>\n                    <div class=\"bundle-status\">Coming Soon</div>\n                </div>\n            </div>\n        </div>\n\n        <div class=\"footer-logo\">\n            <img src=\"https://c3eku948.caspio.com/dp/a0e150004df4984fb1ef4d30b01a/files/9172189\" alt=\"WCTTR Logo\">\n        </div>\n    </main>\n\n    <script src=\"https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.bundle.min.js\"></script>\n</body>\n</html>\n",
