    {
      "file": "calculators/service-price-cheat-sheet.html",
      "html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <meta name=\"robots\" content=\"noindex, nofollow\">\n    <title>Shop Menu | Northwest Custom Apparel</title>\n    <link rel=\"icon\" href=\"/favicon.png\" type=\"image/png\">\n    <!-- Menu typography: Bodoni Moda for the masthead and course titles, Libre Franklin for items and codes -->\n    <link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n    <link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\n    <link href=\"https://fonts.googleapis.com/css2?family=Bodoni+Moda:ital,opsz,wght@0,6..96,400;0,6..96,600;0,6..96,700;1,6..96,400&family=Libre+Franklin:ital,wght@0,400;0,500;0,600;1,400&display=swap\" rel=\"stylesheet\">\n    <link rel=\"stylesheet\" href=\"https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css\">\n    <!-- Page styles -->\n    <link rel=\"stylesheet\" href=\"/shared_components/css/tokens.css?v=2026.09.08.2\">\n    <link rel=\"stylesheet\" href=\"/calculators/service-price-cheat-sheet.css?v=2026.09.07.12\">\n</head>\n<body class=\"view-rep\">\n    <!-- Staff bar: never prints -->\n    <header class=\"topbar\">\n        <a href=\"/staff-dashboard.html\" class=\"topbar-link\"><i class=\"fas fa-arrow-left\" aria-hidden=\"true\"></i> Staff Dashboard</a>\n        <div class=\"topbar-spacer\"></div>\n        <div class=\"view-toggle\" role=\"group\" aria-label=\"Menu view\">\n            <button type=\"button\" class=\"view-btn is-active\" data-view=\"rep\" aria-pressed=\"true\">Rep view <small>codes &amp; book times</small></button>\n            <button type=\"button\" class=\"view-btn\" data-view=\"customer\" aria-pressed=\"false\">Customer view <small>prices only</small></button>\n        </div>\n        <button type=\"button\" class=\"topbar-link topbar-link--solid\" id=\"printCustomerBtn\" title=\"Prints the customer copy: prices only, no codes or book times\"><i class=\"fas fa-print\" aria-hidden=\"true\"></i> Print customer menu</button>\n        <button type=\"button\" class=\"topbar-link\" id=\"printRepBtn\" title=\"Prints the rep copy with ShopWorks codes and book times\"><i class=\"fas fa-print\" aria-hidden=\"true\"></i> Print rep copy</button>\n    </header>\n\n    <div id=\"errorBanner\" class=\"error-banner\" role=\"alert\"></div>\n\n    <main class=\"menu\" id=\"menu\">\n        <header class=\"masthead\">\n            <div class=\"masthead-rule\"></div>\n            <p class=\"masthead-eyebrow\">Northwest Custom Apparel &middot; Milton, Washington</p>\n            <h1 class=\"masthead-title\">Shop Menu</h1>\n            <p class=\"masthead-sub\"><span class=\"est\">Est. 1977</span> &middot; embroidery, sewing, DTF, finishing &amp; laser, priced by the piece &middot; <span id=\"menuDate\">2026</span></p>\n            <div class=\"masthead-rule\"></div>\n            <div class=\"minimum-stamp\" role=\"note\" aria-label=\"Job minimum\">\n                <span class=\"minimum-amount\">$<span data-rule=\"min\">75</span></span>\n                <span class=\"minimum-text\"><strong>minimum per job</strong><br>one hour of bench time &mdash; any service on this menu, one minimum per ticket<span class=\"rep-only\"> &middot; bill the difference on <code>LTM</code></span></span>\n            </div>\n        </header>\n\n        <section class=\"house-rules\" aria-label=\"House rules\">\n            <h2 class=\"house-rules-title\">House Rules</h2>\n            <ol class=\"house-rules-list\">\n                <li><strong>Bring us your goods, we price by the piece.</strong> Price &times; quantity, with a <strong>$<span data-rule=\"min\">75</span> minimum per job</strong><span class=\"rep-only\"> &mdash; bill the difference on <code>LTM</code></span>.</li>\n                <li><strong>Not on the menu?</strong> We quote the time: <strong>$<span data-rule=\"bench\">25</span></strong> per quarter hour at the <strong>bench</strong> (sewing, finishing, hand work) or <strong>$<span data-rule=\"machine\">37.50</span></strong> per quarter hour on a <strong>machine</strong> (embroidery heads, heat press, laser)<span class=\"rep-only\"> &mdash; bench $100/h, machine $150/h; on <code>DECG</code>, <code>DECC</code> or <code>Laser</code>; Erik or Ruthie approves the estimate</span>.</li>\n                <li><strong>Supplies we provide</strong> (transfers, labels, bags, special thread) are priced the same way as our garments<span class=\"rep-only\"> &mdash; our cost &divide; <span data-rule=\"denom\">0.53</span>, never a garment: $1 &rarr; $1.89 &middot; $2 &rarr; $3.77 &middot; $5 &rarr; $9.43 &middot; $10 &rarr; $18.87</span>. Goods you supply are worked at your risk.<span class=\"rep-only\"> <strong>We supply the garment?</strong> Use the quote builder; names, patches and puff are add-ons there at the same prices.</span></li>\n            </ol>\n        </section>\n\n        <div class=\"courses\" id=\"courses\">\n            <p class=\"loading\"><i class=\"fas fa-spinner fa-spin\" aria-hidden=\"true\"></i> Setting the table&hellip;</p>\n        </div>\n\n        <footer class=\"colophon\">\n            <p>2025 Freeman Road East, Milton, WA 98354 &middot; 253-922-5793 &middot; sales@nwcustomapparel.com</p>\n            <p class=\"rep-only\">Prices load from Caspio <code>Service_Codes</code> &mdash; change it there, the menu follows. Loaded <span id=\"loadTimestamp\">&mdash;</span>. Subject to change; sales tax extra.</p>\n            <p class=\"customer-only\">Prices subject to change without notice. Sales tax extra.</p>\n        </footer>\n    </main>\n\n    <script src=\"/shared_components/js/app-config.js?v=2026.09.06.15\"></script>\n    <script src=\"/calculators/service-price-cheat-sheet.js?v=2026.09.06.16\"></script>\n</body>\n</html>\n",
