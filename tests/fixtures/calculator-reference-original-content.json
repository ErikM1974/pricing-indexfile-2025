    {
      "file": "calculators/laser-manual-pricing.html",
      "html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <meta name=\"robots\" content=\"noindex, nofollow\">\n    <title>Manual Laser Pricing Calculator - Northwest Custom Apparel</title>\n    <link rel=\"icon\" href=\"/favicon.png\" type=\"image/png\">\n    <link href=\"https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap\" rel=\"stylesheet\">\n    <link href=\"https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css\" rel=\"stylesheet\">\n    \n    <!-- Shared Calculator Styles -->\n    <link rel=\"stylesheet\" href=\"/shared_components/css/tokens.css?v=2026.09.08.2\">\n    <link href=\"/calculators/manual-calculator-styles.css?v=2026.09.07.19\" rel=\"stylesheet\">\n    \n    <link rel=\"stylesheet\" href=\"/calculators/css/laser-manual-pricing.css?v=2026.09.07.12\">\n</head>\n<body>\n    <!-- Header -->\n    <header class=\"header\">\n        <div class=\"header-container\">\n            <div class=\"header-left\">\n                <img src=\"https://cdn.caspio.com/A0E15000/Safety%20Stripes/web%20northwest%20custom%20apparel%20logo.png?ver=1\" \n                     alt=\"Northwest Custom Apparel\" class=\"logo\">\n                <nav class=\"breadcrumb\">\n                    <a href=\"/staff-dashboard.html\">Dashboard</a>\n                    <span>/</span>\n                    <span>Manual Laser Pricing</span>\n                </nav>\n            </div>\n        </div>\n    </header>\n\n    <!-- Main Content -->\n    <main class=\"main-container\">\n        <div class=\"calculator-title text-center\">\n            <h1>Manual Laser Pricing Calculator</h1>\n            <p>Calculate pricing for laser engraving on customer-supplied items</p>\n        </div>\n\n        <!-- Product Showcase Section -->\n        <div class=\"product-showcase\">\n            <div class=\"product-showcase-inner\">\n                <div class=\"product-showcase-image\">\n                    <img src=\"https://c3eku948.caspio.com/dp/a0e150004df4984fb1ef4d30b01a/files/9094664\" \n                         alt=\"Laser Engraved Leatherette Patches and Richardson Cap\" \n                         title=\"Professional Laser Engraving Services\">\n                </div>\n                <div class=\"product-showcase-content\">\n                    <h3><i class=\"fas fa-star\" aria-hidden=\"true\"></i> Premium Laser Engraving Services</h3>\n                    <p class=\"lm-intro\">\n                        Transform ordinary items into extraordinary keepsakes with our precision laser engraving. \n                        From leatherette patches on Richardson caps to custom awards and promotional products, \n                        our state-of-the-art laser technology delivers crisp, permanent designs that make a lasting impression.\n                    </p>\n                    <div class=\"product-features\">\n                        <div class=\"feature-item\">\n                            <i class=\"fas fa-check-circle\" aria-hidden=\"true\"></i>\n                            <span>Leatherette patches</span>\n                        </div>\n                        <div class=\"feature-item\">\n                            <i class=\"fas fa-check-circle\" aria-hidden=\"true\"></i>\n                            <span>Richardson caps</span>\n                        </div>\n                        <div class=\"feature-item\">\n                            <i class=\"fas fa-check-circle\" aria-hidden=\"true\"></i>\n                            <span>Awards & trophies</span>\n                        </div>\n                        <div class=\"feature-item\">\n                            <i class=\"fas fa-check-circle\" aria-hidden=\"true\"></i>\n                            <span>Promotional items</span>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </div>\n\n        <!-- Coming Soon Notice -->\n        <div class=\"coming-soon\">\n            <i class=\"fas fa-cube coming-soon-icon\" aria-hidden=\"true\"></i>\n            <h2>Coming Soon!</h2>\n            <p>The Manual Laser Pricing Calculator is currently under development. Check back soon!</p>\n        </div>\n\n        <!-- Calculator Grid (Placeholder) -->\n        <div class=\"calculator-grid\">\n            <!-- Input Section -->\n            <div class=\"card\">\n                <h2 class=\"card-title\">\n                    <i class=\"fas fa-laser-pointer lm-icon-primary\" aria-hidden=\"true\"></i>\n                    Laser Engraving Details\n                </h2>\n                \n                <div class=\"placeholder-section\">\n                    <i class=\"fas fa-cog fa-3x mb-3 lm-icon-muted\" aria-hidden=\"true\"></i>\n                    <p>Input fields for manual laser pricing will appear here</p>\n                    <p class=\"mt-2 text-muted\">Features will include:</p>\n                    <ul class=\"lm-plain-list\">\n                        <li>• Manual item cost input</li>\n                        <li>• Engraving area size</li>\n                        <li>• Material type selection</li>\n                        <li>• Setup and runtime calculation</li>\n                        <li>• Quantity-based pricing</li>\n                    </ul>\n                </div>\n            </div>\n\n            <!-- Results Section -->\n            <div class=\"card\">\n                <div class=\"results-section\">\n                    <div class=\"results-header\">\n                        <h3 class=\"card-title\">Your Quote</h3>\n                        <div class=\"price-display prompt\">\n                            <i class=\"fas fa-calculator\" aria-hidden=\"true\"></i>\n                            Calculator Loading...\n                        </div>\n                    </div>\n                    \n                    <div class=\"placeholder-section mt-3\">\n                        <i class=\"fas fa-file-invoice-dollar fa-3x mb-3 lm-icon-muted\" aria-hidden=\"true\"></i>\n                        <p>Pricing breakdown will appear here</p>\n                    </div>\n                </div>\n            </div>\n        </div>\n\n        <!-- Information Section -->\n        <div class=\"card\">\n            <h3 class=\"card-title\">\n                <i class=\"fas fa-info-circle lm-icon-primary\" aria-hidden=\"true\"></i>\n                About Manual Laser Pricing\n            </h3>\n            <div class=\"alert alert-info\">\n                <i class=\"fas fa-lightbulb alert-icon\" aria-hidden=\"true\"></i>\n                <div>\n                    <p><strong>What is Manual Laser Pricing?</strong></p>\n                    <p>This calculator will help you price laser engraving services for customer-supplied items such as tumblers, awards, promotional products, and more. It will account for engraving size, material type, and quantity to provide accurate pricing.</p>\n                </div>\n            </div>\n        </div>\n    </main>\n</body>\n</html>",
