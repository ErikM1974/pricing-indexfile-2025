{
  "base": "99db3fd9d6af43dddae384b9f48a12c6f49d5ed1",
  "pages": [
    {
      "file": "calculators/manual-pricing.html",
      "html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <meta name=\"robots\" content=\"noindex, nofollow\">\n    <title>Manual Pricing Calculator 2026 | Northwest Custom Apparel</title>\n    <link rel=\"icon\" href=\"/favicon.png\" type=\"image/png\">\n\n    <!-- Font Awesome -->\n    <link rel=\"stylesheet\" href=\"https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css\">\n    <!-- Google Fonts -->\n    <link href=\"https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap\" rel=\"stylesheet\">\n\n    <!-- Base calculator styles + page-specific styles -->\n    <link rel=\"stylesheet\" href=\"/shared_components/css/tokens.css?v=2026.09.08.2\">\n    <link rel=\"stylesheet\" href=\"/calculators/manual-calculator-styles.css?v=2026.09.07.19\">\n    <link rel=\"stylesheet\" href=\"/calculators/manual-pricing.css?v=2026.09.07.19\">\n    <script src=\"/config/app.config.js\"></script>\n</head>\n<body>\n    <!-- Global Error Banner -->\n    <div id=\"apiErrorBanner\" class=\"api-error-banner hidden\">\n        <i class=\"fas fa-exclamation-triangle\" aria-hidden=\"true\"></i>\n        <span id=\"apiErrorMessage\">Unable to load pricing data. Please refresh the page.</span>\n    </div>\n\n    <main class=\"main-container\">\n        <!-- Header -->\n        <header class=\"header\">\n            <div class=\"header-container\">\n                <div class=\"header-left\">\n                    <div class=\"breadcrumb\">\n                        <a href=\"/staff-dashboard.html\">Staff Dashboard</a>\n                        <span>/</span>\n                        <span>Manual Pricing</span>\n                    </div>\n                </div>\n            </div>\n        </header>\n\n        <!-- Page Title -->\n        <h1 class=\"page-title\">\n            <i class=\"fas fa-calculator\" aria-hidden=\"true\"></i> Manual Pricing Calculator 2026\n        </h1>\n        <p class=\"page-subtitle\">Embroidered Garments, Embroidered Caps, Screen Print, DTG and DTF. Enter the blank cost from your supplier.</p>\n\n        <!-- Input Section -->\n        <div class=\"input-section\">\n            <div class=\"input-row\">\n                <div class=\"cost-input-group\">\n                    <label for=\"blankCost\">Blank Cost</label>\n                    <div class=\"cost-input-wrapper\">\n                        <span class=\"dollar-sign\">$</span>\n                        <input type=\"number\"\n                               id=\"blankCost\"\n                               class=\"cost-input\"\n                               step=\"0.01\"\n                               min=\"0.01\"\n                               max=\"999.99\"\n                               placeholder=\"e.g. 6.25\"\n                               data-enter-clicks=\"calculateBtn\">\n                    </div>\n                </div>\n\n                <div class=\"item-type-group\">\n                    <label>Item Type</label>\n                    <div class=\"toggle-buttons\">\n                        <button class=\"toggle-btn active\" data-type=\"garment\" data-call=\"manualCalc.setItemType\" data-args='[\"garment\"]'>\n                            <i class=\"fas fa-tshirt\" aria-hidden=\"true\"></i> Garment\n                        </button>\n                        <button class=\"toggle-btn\" data-type=\"cap\" data-call=\"manualCalc.setItemType\" data-args='[\"cap\"]'>\n                            <i class=\"fas fa-hat-cowboy\" aria-hidden=\"true\"></i> Cap\n                        </button>\n                    </div>\n                </div>\n\n                <div class=\"calculate-group\">\n                    <label>&nbsp;</label>\n                    <button id=\"calculateBtn\" class=\"btn-calculate\" data-call=\"manualCalc.calculate\">\n                        <i class=\"fas fa-calculator\" aria-hidden=\"true\"></i> Calculate\n                    </button>\n                </div>\n            </div>\n            <p class=\"input-hint\">Enter the blank garment/cap cost from your supplier (S&S Active Wear, etc.)</p>\n            <div id=\"inputError\" class=\"input-error\">\n                <i class=\"fas fa-exclamation-circle\" aria-hidden=\"true\"></i>\n                <span id=\"inputErrorText\"></span>\n            </div>\n        </div>\n\n        <!-- Method Cards Container -->\n        <div id=\"methodCards\" class=\"methods-container\" style=\"display: none;\">\n\n            <!-- GARMENT MODE CARDS -->\n            <div id=\"garmentCards\">\n\n                <!-- DTG Card -->\n                <div class=\"method-card\" id=\"dtgCard\">\n                    <div class=\"method-card-header\">\n                        <h3 class=\"method-card-title\">\n                            <span class=\"method-icon dtg\"><i class=\"fas fa-print\" aria-hidden=\"true\"></i></span>\n                            DTG (Direct-to-Garment)\n                        </h3>\n                        <div class=\"method-card-controls\">\n                            <select id=\"dtgLocation\" aria-label=\"DTG print location\" class=\"method-select\" data-change=\"manualCalc.onDTGLocationChange\">\n                                <!-- Populated by JS: front locations only (LC, FF, JF) -->\n                            </select>\n                            <div class=\"ltm-qty-picker\">\n                                <label for=\"dtgLtmQty\">LTM qty:</label>\n                                <input type=\"number\" id=\"dtgLtmQty\" class=\"method-select ltm-qty-input\"\n                                       min=\"1\" max=\"23\" value=\"12\"\n                                       data-change=\"manualCalc.onDTGLtmQtyChange\">\n                            </div>\n                            <div class=\"sp-extra-controls\">\n                                <label class=\"sp-toggle-label\">\n                                    <input type=\"checkbox\" id=\"dtgSecondLocation\" data-change=\"manualCalc.onDTGSecondLocationChange\">\n                                    + Back location:\n                                </label>\n                                <select id=\"dtgSecondLocationSelect\" class=\"method-select\" aria-label=\"DTG second print location\" style=\"display:none\"\n                                        data-change=\"manualCalc.onDTGSecondLocationSelectChange\">\n                                    <!-- Populated by JS: back locations only (FB, JB) -->\n                                </select>\n                            </div>\n                        </div>\n                    </div>\n                    <div class=\"method-card-body\" id=\"dtgBody\">\n                        <div class=\"card-placeholder\">Enter a cost and click Calculate</div>\n                    </div>\n                </div>\n\n                <!-- DTF Card -->\n                <div class=\"method-card\" id=\"dtfCard\">\n                    <div class=\"method-card-header\">\n                        <h3 class=\"method-card-title\">\n                            <span class=\"method-icon dtf\"><i class=\"fas fa-film\" aria-hidden=\"true\"></i></span>\n                            DTF (Direct-to-Film)\n                        </h3>\n                        <div class=\"method-card-controls\">\n                            <select id=\"dtfTransferSize\" aria-label=\"DTF transfer size\" class=\"method-select\" data-change=\"manualCalc.onDTFSizeChange\">\n                                <option value=\"small\">Small (5\" x 5\")</option>\n                                <option value=\"medium\" selected>Medium (9\" x 12\")</option>\n                                <option value=\"large\">Large (12\" x 16.5\")</option>\n                            </select>\n                            <div class=\"ltm-qty-picker\">\n                                <label for=\"dtfLtmQty\">LTM qty:</label>\n                                <input type=\"number\" id=\"dtfLtmQty\" class=\"method-select ltm-qty-input\"\n                                       min=\"10\" max=\"23\" value=\"12\"\n                                       data-change=\"manualCalc.onDTFLtmQtyChange\">\n                            </div>\n                            <div class=\"sp-extra-controls\">\n                                <label class=\"sp-toggle-label\">\n                                    <input type=\"checkbox\" id=\"dtfSecondLocation\" data-change=\"manualCalc.onDTFSecondLocationChange\">\n                                    2nd location:\n                                </label>\n                                <select id=\"dtfSecondTransferSize\" class=\"method-select\" aria-label=\"DTF second transfer size\" style=\"display:none\"\n                                        data-change=\"manualCalc.onDTFSecondLocationChange\">\n                                    <option value=\"small\">Small (5\" x 5\")</option>\n                                    <option value=\"medium\" selected>Medium (9\" x 12\")</option>\n                                    <option value=\"large\">Large (12\" x 16.5\")</option>\n                                </select>\n                            </div>\n                        </div>\n                    </div>\n                    <div class=\"method-card-body\" id=\"dtfBody\">\n                        <div class=\"card-placeholder\">Enter a cost and click Calculate</div>\n                    </div>\n                </div>\n\n                <!-- Embroidery Card -->\n                <div class=\"method-card\" id=\"embCard\">\n                    <div class=\"method-card-header\">\n                        <h3 class=\"method-card-title\">\n                            <span class=\"method-icon emb\"><i class=\"fas fa-needle\" aria-hidden=\"true\"></i></span>\n                            Embroidery\n                        </h3>\n                        <div class=\"method-card-controls\">\n                            <div class=\"ltm-qty-picker\">\n                                <label for=\"embLtmQty\">1-7 qty:</label>\n                                <select id=\"embLtmQty\" class=\"method-select ltm-select\" data-change=\"manualCalc.onEmbLTMQtyChange\">\n                                    <option value=\"1\">1 pc</option>\n                                    <option value=\"2\">2 pcs</option>\n                                    <option value=\"3\" selected>3 pcs</option>\n                                    <option value=\"4\">4 pcs</option>\n                                    <option value=\"5\">5 pcs</option>\n                                    <option value=\"6\">6 pcs</option>\n                                    <option value=\"7\">7 pcs</option>\n                                </select>\n                                <span class=\"text-muted stitch-note\">8K stitches</span>\n                            </div>\n                        </div>\n                    </div>\n                    <div class=\"method-card-body\" id=\"embBody\">\n                        <div class=\"card-placeholder\">Enter a cost and click Calculate</div>\n                    </div>\n                </div>\n\n                <!-- Screen Print Card -->\n                <div class=\"method-card\" id=\"spCard\">\n                    <div class=\"method-card-header\">\n                        <h3 class=\"method-card-title\">\n                            <span class=\"method-icon sp\"><i class=\"fas fa-palette\" aria-hidden=\"true\"></i></span>\n                            Screen Print\n                        </h3>\n                        <div class=\"method-card-controls\">\n                            <select id=\"spColors\" aria-label=\"Screen print colors\" class=\"method-select\" data-change=\"manualCalc.onSPColorChange\">\n                                <!-- Populated by JS with available color counts -->\n                            </select>\n                            <div class=\"ltm-qty-picker\">\n                                <label for=\"spLtmQty\">LTM qty:</label>\n                                <input type=\"number\" id=\"spLtmQty\" class=\"method-select ltm-qty-input\"\n                                       min=\"24\" max=\"71\" value=\"36\"\n                                       data-change=\"manualCalc.onSPLtmQtyChange\">\n                            </div>\n                        </div>\n                    </div>\n                    <div class=\"method-card-body\" id=\"spBody\">\n                        <div class=\"card-placeholder\">Enter a cost and click Calculate</div>\n                    </div>\n                </div>\n            </div>\n\n            <!-- CAP MODE CARDS -->\n            <div id=\"capCards\" style=\"display: none;\">\n\n                <!-- Cap Embroidery Card -->\n                <div class=\"method-card\" id=\"capEmbCard\">\n                    <div class=\"method-card-header\">\n                        <h3 class=\"method-card-title\">\n                            <span class=\"method-icon cap\"><i class=\"fas fa-hat-cowboy\" aria-hidden=\"true\"></i></span>\n                            Cap Embroidery\n                        </h3>\n                        <div class=\"method-card-controls\">\n                            <div class=\"ltm-qty-picker\">\n                                <label for=\"capEmbLtmQty\">1-7 qty:</label>\n                                <select id=\"capEmbLtmQty\" class=\"method-select ltm-select\" data-change=\"manualCalc.onCapEmbLTMQtyChange\">\n                                    <option value=\"1\">1 pc</option>\n                                    <option value=\"2\">2 pcs</option>\n                                    <option value=\"3\" selected>3 pcs</option>\n                                    <option value=\"4\">4 pcs</option>\n                                    <option value=\"5\">5 pcs</option>\n                                    <option value=\"6\">6 pcs</option>\n                                    <option value=\"7\">7 pcs</option>\n                                </select>\n                                <span class=\"text-muted stitch-note\">8K stitches</span>\n                            </div>\n                        </div>\n                    </div>\n                    <div class=\"method-card-body\" id=\"capEmbBody\">\n                        <div class=\"card-placeholder\">Enter a cost and click Calculate</div>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </main>\n\n    <!-- Pricing Service Dependencies -->\n    <!-- Canonical DTG engine (Batch 6) - MUST precede dtg-pricing-service.js -->\n    <script src=\"/shared_components/js/dtg-canonical-pricing.js?v=2026.07.11.6\"></script>\n    <script src=\"/shared_components/js/dtg-pricing-service.js?v=2026.09.06.37\"></script>\n    <script src=\"/shared_components/js/dtf-pricing-service.js?v=2026.09.06.37\"></script>\n    <script src=\"/shared_components/js/embroidery-pricing-service.js?v=2026.09.06.31\"></script>\n    <script src=\"/shared_components/js/data-call-delegator.js?v=2026.09.06.27\"></script>\n    <script src=\"/shared_components/js/cap-embroidery-pricing-service.js?v=2026.09.06.31\"></script>\n    <script src=\"/shared_components/js/screenprint-pricing-service.js?v=2026.09.06.44\"></script>\n\n    <!-- Page Logic -->\n    <script src=\"/calculators/manual-pricing.js?v=2026.09.06.16\"></script>\n</body>\n</html>\n",
