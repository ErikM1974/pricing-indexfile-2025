    {
      "file": "pages/vendor-portal.html",
      "html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n  <meta name=\"robots\" content=\"noindex, nofollow\">\n  <title>Job Portal — Northwest Custom Apparel</title>\n  <link rel=\"icon\" href=\"/favicon.png\">\n  <link rel=\"stylesheet\" href=\"/shared_components/css/tokens.css?v=2026.09.08.2\">\n  <link rel=\"stylesheet\" href=\"/shared_components/vendor/fontawesome/css/all.min.css?v=2026.07.08.8\">\n  <link rel=\"stylesheet\" href=\"/pages/css/vendor-portal.css?v=2026.09.07.19\">\n</head>\n<body>\n  <header class=\"vp-header\">\n    <div class=\"vp-header-inner\">\n      <img class=\"vp-logo\" src=\"https://cdn.caspio.com/A0E15000/Safety%20Stripes/web%20northwest%20custom%20apparel%20logo.png\" alt=\"Northwest Custom Apparel\">\n      <div class=\"vp-header-title\">\n        <h1 id=\"vp-vendor-name\">Job Portal</h1>\n        <span class=\"vp-header-sub\">Screen-print jobs from Northwest Custom Apparel</span>\n      </div>\n      <div class=\"vp-header-user\">\n        <span id=\"vp-user-chip\" class=\"vp-user-chip\"><i class=\"fas fa-user\" aria-hidden=\"true\"></i> <span id=\"vp-user-email\"></span></span>\n        <a class=\"vp-btn vp-btn--ghost\" href=\"/auth/vendor/logout\"><i class=\"fas fa-sign-out-alt\" aria-hidden=\"true\"></i> Sign out</a>\n      </div>\n    </div>\n  </header>\n\n  <main class=\"vp-container\">\n    <!-- Error banner (API failures are always VISIBLE — never silent) -->\n    <div id=\"vp-error\" class=\"vp-error\" role=\"alert\" hidden>\n      <i class=\"fas fa-exclamation-triangle\" aria-hidden=\"true\"></i>\n      <span id=\"vp-error-text\">Unable to load jobs. Please refresh.</span>\n      <button type=\"button\" class=\"vp-btn vp-btn--ghost vp-btn--sm\" id=\"vp-error-retry\" hidden><i class=\"fas fa-rotate-right\" aria-hidden=\"true\"></i> Retry</button>\n    </div>\n\n    <!-- ── LIST VIEW ─────────────────────────────────────────── -->\n    <section id=\"vp-list-view\">\n      <div class=\"vp-toolbar\">\n        <div class=\"vp-filters\" id=\"vp-filters\" role=\"group\" aria-label=\"Filter jobs\">\n          <button type=\"button\" class=\"vp-chip vp-chip--active\" data-filter=\"active\" aria-pressed=\"true\">Active <span class=\"vp-chip-count\" data-count=\"active\"></span></button>\n          <button type=\"button\" class=\"vp-chip\" data-filter=\"completed\" aria-pressed=\"false\">Completed <span class=\"vp-chip-count\" data-count=\"completed\"></span></button>\n          <button type=\"button\" class=\"vp-chip\" data-filter=\"all\" aria-pressed=\"false\">All <span class=\"vp-chip-count\" data-count=\"all\"></span></button>\n        </div>\n        <div class=\"vp-search\">\n          <label for=\"vp-search\" class=\"vp-sr\">Search jobs</label>\n          <i class=\"fas fa-search\" aria-hidden=\"true\"></i>\n          <input type=\"search\" id=\"vp-search\" placeholder=\"Search company, design #, job #\" autocomplete=\"off\">\n        </div>\n      </div>\n\n      <div id=\"vp-loading\" class=\"vp-loading\" role=\"status\"><i class=\"fas fa-spinner fa-spin\" aria-hidden=\"true\"></i> Loading jobs…</div>\n      <div id=\"vp-empty\" class=\"vp-empty\" role=\"status\" hidden>\n        <i class=\"fas fa-inbox\" aria-hidden=\"true\"></i>\n        <p id=\"vp-empty-text\">No jobs here right now.</p>\n      </div>\n      <div id=\"vp-job-grid\" class=\"vp-job-grid\"></div>\n    </section>\n\n    <!-- ── DETAIL VIEW ───────────────────────────────────────── -->\n    <section id=\"vp-detail-view\" hidden>\n      <button type=\"button\" class=\"vp-btn vp-btn--ghost vp-back\" id=\"vp-back-btn\"><i class=\"fas fa-arrow-left\" aria-hidden=\"true\"></i> All jobs</button>\n\n      <div id=\"vp-detail-loading\" class=\"vp-loading\" role=\"status\"><i class=\"fas fa-spinner fa-spin\" aria-hidden=\"true\"></i> Loading job…</div>\n\n      <div id=\"vp-detail-main\" hidden>\n        <div class=\"vp-detail-header\">\n          <div>\n            <div class=\"vp-detail-id\" id=\"vp-d-id\"></div>\n            <h2 class=\"vp-detail-company\" id=\"vp-d-company\" tabindex=\"-1\"></h2>\n            <div class=\"vp-detail-sub\" id=\"vp-d-sub\"></div>\n          </div>\n          <div class=\"vp-detail-badges\" id=\"vp-d-badges\"></div>\n        </div>\n\n        <div class=\"vp-grid\">\n          <div class=\"vp-col\">\n            <div class=\"vp-card\">\n              <div class=\"vp-card-header\"><h3><i class=\"fas fa-clipboard-list\" aria-hidden=\"true\"></i> Work Order</h3></div>\n              <div class=\"vp-card-body\">\n                <dl class=\"vp-meta\" id=\"vp-d-meta\"></dl>\n                <div class=\"vp-instructions\" id=\"vp-d-instructions\" hidden></div>\n              </div>\n            </div>\n\n            <div class=\"vp-card\">\n              <div class=\"vp-card-header\"><h3><i class=\"fas fa-layer-group\" aria-hidden=\"true\"></i> Print Lines</h3></div>\n              <div class=\"vp-card-body\">\n                <div class=\"vp-table-scroll\">\n                  <table class=\"vp-table\" id=\"vp-d-lines-table\">\n                    <thead>\n                      <tr><th>Qty</th><th>Size</th><th>W×H (in)</th><th>Presses</th><th>Notes</th></tr>\n                    </thead>\n                    <tbody id=\"vp-d-lines\"></tbody>\n                  </table>\n                </div>\n                <div class=\"vp-empty-panel\" id=\"vp-d-lines-empty\" hidden>No print lines on this job.</div>\n              </div>\n            </div>\n\n            <div class=\"vp-card\">\n              <div class=\"vp-card-header\"><h3><i class=\"fas fa-download\" aria-hidden=\"true\"></i> Artwork &amp; Working Files</h3></div>\n              <div class=\"vp-card-body\">\n                <div id=\"vp-d-files\" class=\"vp-files\"></div>\n                <div class=\"vp-empty-panel\" id=\"vp-d-files-empty\" hidden>No files attached yet.</div>\n              </div>\n            </div>\n          </div>\n\n          <div class=\"vp-col\">\n            <div class=\"vp-card\">\n              <div class=\"vp-card-header\"><h3><i class=\"fas fa-image\" aria-hidden=\"true\"></i> Mockup</h3></div>\n              <div class=\"vp-card-body\" id=\"vp-d-mockup\">\n                <div class=\"vp-empty-panel\">No mockup attached.</div>\n              </div>\n            </div>\n\n            <div class=\"vp-card\">\n              <div class=\"vp-card-header\"><h3><i class=\"fas fa-comments\" aria-hidden=\"true\"></i> Activity &amp; Messages</h3></div>\n              <div class=\"vp-card-body\">\n                <div class=\"vp-comment-form\">\n                  <label for=\"vp-comment-input\" class=\"vp-sr\">Message for NWCA</label>\n                  <textarea id=\"vp-comment-input\" rows=\"2\" maxlength=\"2000\" placeholder=\"Question or update for NWCA? Post it here…\" aria-describedby=\"vp-comment-hint\"></textarea>\n                  <button type=\"button\" class=\"vp-btn vp-btn--primary\" id=\"vp-comment-btn\" disabled><i class=\"fas fa-paper-plane\" aria-hidden=\"true\"></i> Post</button>\n                </div>\n                <div class=\"vp-comment-hint\" id=\"vp-comment-hint\">Ctrl+Enter posts. NWCA sees your note on the job.</div>\n                <div class=\"vp-comment-status\" id=\"vp-comment-status\" role=\"status\" hidden></div>\n                <div class=\"vp-timeline\" id=\"vp-d-notes\"></div>\n              </div>\n            </div>\n          </div>\n        </div>\n      </div>\n    </section>\n  </main>\n\n  <footer class=\"vp-footer\">\n    Northwest Custom Apparel &middot; Milton, WA &middot; (253) 922-5793\n  </footer>\n\n  <script src=\"/shared_components/js/caspio-date-utils.js?v=2026.09.06.46\"></script>\n  <script src=\"/pages/js/vendor-portal.js?v=2026.09.05.29\"></script>\n</body>\n</html>\n",
